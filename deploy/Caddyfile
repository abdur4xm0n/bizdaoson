# bizdaoson.uz - Caddy veb-server sozlamasi
# Serverdagi joyi: /etc/caddy/Caddyfile
# HTTPS sertifikati (Let's Encrypt) avtomatik olinadi va yangilanadi.

# Umumiy sozlamalar (pastdagi saytlar "import sayt" bilan ishlatadi)
(sayt) {
	root * /opt/bizdaoson/site
	encode zstd gzip

	# Qisqa buyruqlar:  irm bizdaoson.uz/win | iex
	@skript path /win /diag /yordam /tozalash /yangilash
	rewrite @skript {path}.ps1

	# PowerShell skriptlari oddiy matn (UTF-8) sifatida beriladi
	@matn path /win /diag /yordam /tozalash /yangilash *.ps1
	header @matn {
		Content-Type "text/plain; charset=utf-8"
		Cache-Control "no-cache"
		defer
	}
	header /apps.json Cache-Control "no-cache"

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	file_server
}

bizdaoson.uz {
	import sayt

	# Statistika: nechta odam skriptni ishga tushirgani shu yerda ko'rinadi
	log {
		output file /var/log/caddy/bizdaoson.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}

www.bizdaoson.uz {
	redir https://bizdaoson.uz{uri} permanent
}

# Domen orqali kelgan oddiy HTTP doim HTTPS'ga yo'naltiriladi.
# "irm bizdaoson.uz/win" avval http:// bilan so'raydi - skript faqat shifrlangan holda yetib borsin.
http://bizdaoson.uz, http://www.bizdaoson.uz {
	redir https://bizdaoson.uz{uri} permanent
}

# IP manzil yoki lokal tarmoq orqali (oddiy HTTP), masalan:  irm 192.168.1.10/win | iex
# Domen DNS'i hali ulanmaganda sinash uchun ham qulay.
:80 {
	import sayt
}
